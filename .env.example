APP_NAME="Bulut Filo Yönetimi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Matches docker-compose.yml's mysql service — DB_DATABASE/DB_PASSWORD are
# also read by docker-compose itself to configure the MySQL container.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bulut_filo_yonetimi
DB_USERNAME=root
DB_PASSWORD=secret

REDIS_HOST=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Required for the Excel import pipeline to actually resolve addresses.
# Without these, imported rows will fail at the address-normalisation step
# — everything else (vehicle list, institutions, auth) works without them.
OPENAI_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
